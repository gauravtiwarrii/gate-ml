{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/practice", "destination": "/gate-ml-practice.html" },
    { "source": "/guide", "destination": "/ml-guide.html" },
    { "source": "/ml-guide", "destination": "/ml-guide.html" },
    { "source": "/topics", "destination": "/topics/index.html" },
    { "source": "/topics/probability", "destination": "/topics/probability.html" },
    { "source": "/topics/statistics", "destination": "/topics/statistics.html" },
    { "source": "/topics/linear-algebra", "destination": "/topics/linear-algebra.html" },
    { "source": "/topics/machine-learning", "destination": "/topics/machine-learning.html" },
    { "source": "/topics/deep-learning", "destination": "/topics/deep-learning.html" },
    { "source": "/questions", "destination": "/questions/index.html" },
    { "source": "/mock-test", "destination": "/mock-test/index.html" },
    { "source": "/resources", "destination": "/resources/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/disclaimer", "destination": "/disclaimer/index.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy/index.html" },
    { "source": "/product", "destination": "/product/index.html" },
    { "source": "/claude", "destination": "/claude/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/changelog", "destination": "/changelog/index.html" },
    { "source": "/readiness", "destination": "/readiness/index.html" },
    { "source": "/syllabus", "destination": "/syllabus/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/practice-da", "destination": "/practice-da/index.html" },
    { "source": "/mock-da", "destination": "/mock-da/index.html" },
    { "source": "/pyq", "destination": "/pyq/index.html" },
    { "source": "/revision", "destination": "/revision/index.html" },
    { "source": "/planner", "destination": "/planner/index.html" },
    { "source": "/tutor", "destination": "/tutor/index.html" },
    { "source": "/learn/calculus", "destination": "/learn/calculus/index.html" },
    { "source": "/learn/programming", "destination": "/learn/programming/index.html" },
    { "source": "/learn/dbms", "destination": "/learn/dbms/index.html" },
    { "source": "/learn/ai", "destination": "/learn/ai/index.html" },
    { "source": "/learn/aptitude", "destination": "/learn/aptitude/index.html" },
    { "source": "/coverage", "destination": "/coverage/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}

